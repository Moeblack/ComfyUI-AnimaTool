{
  "name": "generate_anima_image",
  "description": "Anima 二次元图片生成。调用方按顺序填入结构化字段，须明确安全标签（safe/sensitive/nsfw/explicit）。",
  "parameters": {
    "type": "object",
    "properties": {
      "prompt_hint": {
        "type": "string",
        "description": "日志回显用摘要"
      },
      "aspect_ratio": {
        "type": "string",
        "description": "长宽比，默认 1:1",
        "enum": [
          "21:9",
          "2:1",
          "16:9",
          "16:10",
          "5:3",
          "3:2",
          "4:3",
          "1:1",
          "3:4",
          "2:3",
          "3:5",
          "10:16",
          "9:16",
          "1:2",
          "9:21"
        ]
      },
      "target_megapixels": {
        "type": "number",
        "description": "目标像素数（MP），默认 1.0",
        "default": 1.0
      },
      "width": {
        "type": "integer",
        "description": "宽度，须为 16 倍数",
        "minimum": 64
      },
      "height": {
        "type": "integer",
        "description": "高度，须为 16 倍数",
        "minimum": 64
      },
      "round_to": {
        "type": "integer",
        "description": "宽高对齐倍数，默认 16",
        "default": 16,
        "minimum": 16
      },
      "batch_size": {
        "type": "integer",
        "description": "批量大小",
        "default": 1,
        "minimum": 1
      },
      "seed": {
        "type": "integer",
        "description": "随机种子",
        "minimum": 0
      },
      "steps": {
        "type": "integer",
        "description": "步数，推荐 25-50",
        "default": 25,
        "minimum": 1,
        "maximum": 200
      },
      "cfg": {
        "type": "number",
        "description": "CFG，推荐 4-5",
        "default": 4.5,
        "minimum": 0,
        "maximum": 30
      },
      "sampler_name": {
        "type": "string",
        "description": "采样器，默认 er_sde",
        "default": "er_sde"
      },
      "scheduler": {
        "type": "string",
        "description": "调度器，默认 simple",
        "default": "simple"
      },
      "denoise": {
        "type": "number",
        "description": "降噪强度，默认 1.0",
        "default": 1.0,
        "minimum": 0,
        "maximum": 1
      },
      "filename_prefix": {
        "type": "string",
        "description": "输出文件名前缀",
        "default": "AnimaTool_"
      },
      "quality_meta_year_safe": {
        "type": "string",
        "description": "质量/年份/安全标签，须含 safe/sensitive/nsfw/explicit 之一"
      },
      "count": {
        "type": "string",
        "description": "人数标签，如 '1girl'"
      },
      "character": {
        "type": "string",
        "description": "角色名",
        "default": ""
      },
      "series": {
        "type": "string",
        "description": "作品/系列名",
        "default": ""
      },
      "appearance": {
        "type": "string",
        "description": "角色外观描述",
        "default": ""
      },
      "artist": {
        "type": "string",
        "description": "画师标签，@ 开头，如 @fkey。多画师逗号分隔",
        "default": ""
      },
      "style": {
        "type": "string",
        "description": "画风倾向",
        "default": ""
      },
      "tags": {
        "type": "string",
        "description": "Danbooru 标签，逗号分隔"
      },
      "nltags": {
        "type": "string",
        "description": "自然语言补充",
        "default": ""
      },
      "environment": {
        "type": "string",
        "description": "环境与光影",
        "default": ""
      },
      "neg": {
        "type": "string",
        "description": "负面提示词",
        "default": "worst quality, low quality, score_1, score_2, score_3, blurry, jpeg artifacts, bad anatomy, bad hands, bad feet, extra fingers, missing fingers, extra toes, text, watermark, logo"
      },
      "positive": {
        "type": "string",
        "description": "最终正面提示词（将覆盖结构化拼接）",
        "default": ""
      },
      "negative": {
        "type": "string",
        "description": "负面提示词（等价于 neg）",
        "default": ""
      },
      "clip_name": {
        "type": "string",
        "description": "文本编码器文件名"
      },
      "unet_name": {
        "type": "string",
        "description": "UNET 模型文件名"
      },
      "vae_name": {
        "type": "string",
        "description": "VAE 文件名"
      },
      "loras": {
        "type": "array",
        "description": "LoRA 列表",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "LoRA 文件名，须与 list_anima_models 返回值一致"
            },
            "weight": {
              "type": "number",
              "description": "LoRA 权重",
              "default": 1.0
            }
          },
          "required": [
            "name"
          ]
        }
      }
    },
    "required": [
      "quality_meta_year_safe",
      "count",
      "artist",
      "tags",
      "neg"
    ],
    "additionalProperties": false
  }
}
